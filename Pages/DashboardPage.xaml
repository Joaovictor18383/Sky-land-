<UserControl x:Class="SkyLand.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SkyLand.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="32,26,32,32">

                <Border CornerRadius="16" Padding="24,20"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                        BorderThickness="1" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="580">
                        </StackPanel>
                        <Image Grid.Column="1" Width="280" Height="96"
                               Source="pack://application:,,,/Assets/logo-horizontal.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="24,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Acesso rápido" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Escolha uma ferramenta para começar" Style="{StaticResource T.CardSubtitle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="6 ATALHOS" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" />
                </Grid>

                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                    <controls:QuickTile x:Name="TilePotassium" Title="Potassium"
                                        Subtitle="Baixe o pacote oficial do executor."
                                        ImagePath="pack://application:,,,/Assets/potassium.png" Margin="0,0,12,12" />
                    <controls:QuickTile x:Name="TileMadium" Title="Madium"
                                        Subtitle="Novo instalador 1.1.2 e reparo completo."
                                        ImagePath="pack://application:,,,/Assets/madium.png" Margin="0,0,12,12" />
                    <controls:QuickTile x:Name="TileReal" Title="Real"
                                        Subtitle="Baixe o RealSetup pelo repositório oficial."
                                        ImagePath="pack://application:,,,/Assets/real.png" Margin="0,0,0,12" />
                    <controls:QuickTile x:Name="TileStatus" Title="Status dos executores"
                                        Subtitle="Consulte a disponibilidade em tempo real."
                                        ImagePath="pack://application:,,,/Assets/status_icon.png" Margin="0,0,12,0" />
                    <controls:QuickTile x:Name="TileAnyDesk" Title="AnyDesk"
                                        Subtitle="Acesso remoto com download direto."
                                        ImagePath="pack://application:,,,/Assets/anydesk.png" Margin="0,0,12,0" />
                    <controls:QuickTile x:Name="TileUpdates" Title="Atualizações"
                                        Subtitle="Mantenha o SKY LAND sempre atualizado."
                                        Glyph="&#xE896;" Margin="0" />
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
