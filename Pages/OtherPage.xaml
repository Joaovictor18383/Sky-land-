<UserControl x:Class="SkyLand.Pages.OtherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ops="clr-namespace:SkyLand"
             xmlns:controls="clr-namespace:SkyLand.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="32,24,32,32">

                <TextBlock Text="Outros" Style="{StaticResource T.PageTitle}" Margin="0,0,0,0" />
                <TextBlock Style="{StaticResource T.PageSubtitle}"
                           Text="Status dos executores (WEAO), AnyDesk e ferramentas auxiliares para Roblox."
                           Margin="0,8,0,28" />

                <!-- ===== VERSÃO ROBLOX ===== -->
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Versão do Roblox" Style="{StaticResource T.CardTitle}" FontSize="17" />
                                <TextBlock Text="Versão oficial mais recente do cliente Windows"
                                           Style="{StaticResource T.CardSubtitle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRefreshVersions" Style="{StaticResource BtnGhost}"
                                        Content="Atualizar" Click="OnRefreshVersionsClick" Margin="0,0,10,0" />
                                <Button x:Name="BtnOtherVersions" Style="{StaticResource BtnPrimary}"
                                        Content="Outras versões" Click="OnOtherVersionsClick" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10" Padding="14,12" Margin="0,0,10,0"
                                    Background="{DynamicResource Brush.Surface.Solid2}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="VERSÃO ATUAL" Style="{StaticResource T.Eyebrow}" />
                                    <TextBlock x:Name="RbVersion" Text="—" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0"
                                    Background="{DynamicResource Brush.Surface.Solid2}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LANÇAMENTO" Style="{StaticResource T.Eyebrow}" />
                                    <TextBlock x:Name="RbDate" Text="—" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="10" Padding="14,12" Margin="0,0,10,0"
                                    Background="{DynamicResource Brush.Surface.Solid2}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="STATUS" Style="{StaticResource T.Eyebrow}" />
                                    <TextBlock x:Name="RbStatus" Text="Verificando…" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" CornerRadius="10" Padding="14,12"
                                    Background="{DynamicResource Brush.Surface.Solid2}"
                                    BorderBrush="{DynamicResource Brush.Stroke.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ÚLTIMA CONSULTA" Style="{StaticResource T.Eyebrow}" />
                                    <TextBlock x:Name="RbLastUpdate" Text="—" FontSize="11.5" FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="RbNote" Style="{StaticResource T.Small}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Popup: outras versões -->
                <Popup x:Name="VersionsPopup" PlacementTarget="{Binding ElementName=BtnOtherVersions}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border CornerRadius="12" Padding="6" MinWidth="340"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6"
                                              Direction="270" Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="VERSÕES RECENTES DO ROBLOX" Style="{StaticResource T.Eyebrow}"
                                       Margin="12,10,12,8" />
                            <ItemsControl x:Name="VersionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="12,10" Margin="0,2"
                                                Background="{DynamicResource Brush.Surface.Solid2}"
                                                BorderBrush="{DynamicResource Brush.Stroke.Subtle}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               Text="{Binding DisplayVersion}" />
                                                    <TextBlock Style="{StaticResource T.Small}" Margin="0,3,0,0"
                                                               Text="{Binding DateText, StringFormat='Lançamento: {0}'}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="999" Padding="9,3" Margin="0,0,10,0"
                                                            Background="{DynamicResource Brush.Success.Soft}"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource B2V}}">
                                                        <TextBlock Text="ATUAL" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.Success.Text}" />
                                                    </Border>
                                                    <Button Style="{StaticResource BtnGhost}" Content="Baixar"
                                                            FontSize="11" Padding="12,4"
                                                            Click="OnVersionDownloadClick" Tag="{Binding}"
                                                            ToolTip="Abrir página de downloads de versões (rdd.weao.gg)" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource T.Small}" Margin="12,10,12,8"
                                       Text="Fonte: rdd.weao.gg — versões oficiais do cliente Roblox." />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- ===== STATUS DOS EXECUTORES ===== -->
                <Border Style="{StaticResource Card}" Padding="28">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Status dos executores" Style="{StaticResource T.CardTitle}" FontSize="17" />
                                <TextBlock Text="Consulta em tempo real na API WEAO (weao.xyz)"
                                           Style="{StaticResource T.CardSubtitle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCheck" Style="{StaticResource BtnPrimary}"
                                        Content="Verificar agora" Click="OnCheckClick"
                                        Margin="0,0,12,0" />
                                <Button Style="{StaticResource BtnGhost}" Content="Abrir WEAO"
                                        Click="OnOpenWeaoClick" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="StatusList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                            Background="{DynamicResource Brush.Surface.Solid2}"
                                            BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                                            BorderThickness="1"
                                            Padding="20,16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40">
                                                <Image Width="36" Height="36"
                                                       Source="{Binding Name, Converter={StaticResource NameArt}}"
                                                       Visibility="{Binding Name, Converter={StaticResource ArtVis}}"
                                                       VerticalAlignment="Center" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource T.Small}"
                                                           Margin="0,4,0,0"
                                                           Text="{Binding Detail}" />
                                                <TextBlock FontSize="11" FontWeight="Medium"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           Text="{Binding Compat}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       Text="{Binding State}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource T.Small}" Margin="0,12,0,0"
                                   Text="Fonte: WhatExpsAre.Online (WEAO API). Online = atualizado; Desatualizado = sem atualização compatível." />
                    </StackPanel>
                </Border>

                <!-- ===== ANYDESK ===== -->
                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.AnyDesk}"
                                       Margin="0,16,0,0">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar AnyDesk" Click="OnAnyDeskClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

                <!-- ===== FISHSTRAP ===== -->
                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.Fishstrap}"
                                       Margin="0,16,0,0">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar Fishstrap" Click="OnFishstrapClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

                <!-- ===== ROBLOX ACCOUNT MANAGER ===== -->
                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.Ram}"
                                       Margin="0,16,0,0">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar Account Manager" Click="OnRamClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

                <!-- ===== MULTIBLOXY ===== -->
                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.MultiBloxy}"
                                       Margin="0,16,0,0">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar MultiBloxy" Click="OnMultiBloxyClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
