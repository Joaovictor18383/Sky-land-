<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: VERMELHO ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#170A0C" Offset="0" />
        <GradientStop Color="#1F0D10" Offset="0.5" />
        <GradientStop Color="#2A1014" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#1C0C0F" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#2C1218" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#3B1A22" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#200E13" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#59262E" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#74323C" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#3E1B23" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#34171E" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#74323C" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A1A22" Offset="0" />
        <GradientStop Color="#4C2330" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FDF0F1" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#E0A6AC" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#A06B73" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#F43F5E" />
    <Color x:Key="Accent.Color">#F43F5E</Color>
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#FDA4AF" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#FB7185" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#5C1F2C" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F43F5E" Offset="0" />
        <GradientStop Color="#FB7185" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FDA4AF" Offset="0" />
        <GradientStop Color="#FECDD3" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#14332A" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#33290F" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#331A18" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#14273F" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
