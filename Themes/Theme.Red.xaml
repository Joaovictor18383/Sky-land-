<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: VERMELHO ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A0A0A" Offset="0" />
        <GradientStop Color="#200B0B" Offset="0.45" />
        <GradientStop Color="#260C0C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#2D0D0D" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#401616" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#551E1E" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#250C0C" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#6C2C2C" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#7C3C3C" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#501E1E" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#381414" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#6C2C2C" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D2020" Offset="0" />
        <GradientStop Color="#572626" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FEE8E8" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#E8A8A8" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#A76B6B" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#EF4444" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#7F1D1D" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0" />
        <GradientStop Color="#F87171" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FCA5A5" Offset="0" />
        <GradientStop Color="#FECACA" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
