<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: AZUL ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1128" Offset="0" />
        <GradientStop Color="#0B1430" Offset="0.45" />
        <GradientStop Color="#0C1638" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#0D1A40" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#162850" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1E3A5F" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#112045" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#2D4A6C" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#3D5A7C" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#1E3550" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#192B55" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#2D4A6C" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A365D" Offset="0" />
        <GradientStop Color="#224270" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E8F0FE" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A8C5E8" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#6B8DB0" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#93C5FD" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#1E3A8A" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#60A5FA" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#93C5FD" Offset="0" />
        <GradientStop Color="#BFDBFE" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
