<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA ÚNICO: ROSA ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12050C" Offset="0" />
        <GradientStop Color="#1A0A14" Offset="0.5" />
        <GradientStop Color="#1F0B17" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#10040B" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#25101D" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#331826" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#1D0D17" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#47203C" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#5F2B51" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#2E1526" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#331826" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#A03A6B" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38152E" Offset="0" />
        <GradientStop Color="#481C3C" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FDEFF6" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#D9A7C6" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#8E5E80" />

    <!-- ================ ACENTOS ROSA ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4DA6" />
    <Color x:Key="Accent.Color">#FF4DA6</Color>
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#FF8CC6" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#FF7FB8" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#3D1430" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4DA6" Offset="0" />
        <GradientStop Color="#B8156B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8CC6" Offset="0" />
        <GradientStop Color="#FFB3D9" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#14332A" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#33290F" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#331A18" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#FF8CC6" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#3D1430" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#FFC4E0" />

</ResourceDictionary>
