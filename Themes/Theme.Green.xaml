<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: VERDE ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1C12" Offset="0" />
        <GradientStop Color="#0B2818" Offset="0.45" />
        <GradientStop Color="#0C341E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#0D3522" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#164028" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1E5532" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#11251C" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#2D6C3C" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#3D7C4C" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#1E5028" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#193824" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#2D6C3C" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A4D2E" Offset="0" />
        <GradientStop Color="#225732" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E8F5E8" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A8D4A8" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#6BA76B" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#10B981" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#6EE7B7" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#064E3B" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#34D399" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6EE7B7" Offset="0" />
        <GradientStop Color="#A7F3D0" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
