<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: PRETO ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0B0E" Offset="0" />
        <GradientStop Color="#0D0D11" Offset="0.5" />
        <GradientStop Color="#101014" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#09090C" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#15151B" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1D1D26" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#101014" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#2A2A34" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#40404E" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#1E1E27" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#1F1F29" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#454556" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1A23" Offset="0" />
        <GradientStop Color="#22222E" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F2F2F7" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6A6BC" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#66667E" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B5CF6" />
    <Color x:Key="Accent.Color">#8B5CF6</Color>
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#C4B5FD" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#A78BFA" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#2B2347" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C4B5FD" Offset="0" />
        <GradientStop Color="#DDD6FE" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#14332A" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#33290F" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#331A18" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#14273F" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
