<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TEMA SKY LAND: grafite profundo com o roxo oficial da marca -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#09070F" Offset="0" />
        <GradientStop Color="#100B18" Offset="0.52" />
        <GradientStop Color="#08060D" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#0A0710" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#15101D" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1D1528" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#100C17" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#2B2037" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#49305C" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#21182B" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#1B1424" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#4A3559" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1426" Offset="0" />
        <GradientStop Color="#21172D" Offset="1" />
    </LinearGradientBrush>

    <!-- TEXTO -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F7F1FC" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B9ADC6" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#82738F" />

    <!-- IDENTIDADE SKY LAND -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B17C0" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#DDA5F6" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#B64CE6" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#321641" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B17C0" Offset="0" />
        <GradientStop Color="#B64CE6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DDA5F6" Offset="0" />
        <GradientStop Color="#F0D6FA" Offset="1" />
    </LinearGradientBrush>

    <!-- ESTADOS -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
