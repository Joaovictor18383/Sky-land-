<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: AZUL PROFUNDO (padrão) ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D0D16" Offset="0" />
        <GradientStop Color="#0A0A12" Offset="0.55" />
        <GradientStop Color="#08080E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#090910" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#12121C" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1B1B29" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#171724" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#303044" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#45405E" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#242433" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#242433" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#4A4A61" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B1929" Offset="0" />
        <GradientStop Color="#211B32" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#AAA8BC" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#747186" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#A78BFA" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#A855F7" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#2B2044" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#C4B5FD" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
