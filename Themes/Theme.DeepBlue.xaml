<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: AZUL PROFUNDO (padrão) ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0C15" Offset="0" />
        <GradientStop Color="#0C0F1C" Offset="0.5" />
        <GradientStop Color="#0E1220" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#080A12" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#141827" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1B2138" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#0F1220" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#262C46" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#3B4670" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#1D2338" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#1B2138" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#3D4C7E" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2040" Offset="0" />
        <GradientStop Color="#222B52" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EFF1FF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A7B1D4" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#6B7599" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#6366F1" />
    <Color x:Key="Accent.Color">#6366F1</Color>
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#A5B4FC" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#818CF8" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#232B55" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A5B4FC" Offset="0" />
        <GradientStop Color="#C4B5FD" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#14332A" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#33290F" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#331A18" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#14273F" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
