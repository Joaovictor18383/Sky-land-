<UserControl x:Class="SkyLand.Pages.RealPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ops="clr-namespace:SkyLand"
             xmlns:controls="clr-namespace:SkyLand.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="32,24,32,32">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Image Height="100"
                           Source="pack://application:,,,/Assets/real.png"
                           Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#8B17C0" BlurRadius="28" ShadowDepth="6"
                                              Direction="-90" Opacity="0.5" />
                        </Image.Effect>
                    </Image>
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Real" Style="{StaticResource T.PageTitle}" />
                        <TextBlock Style="{StaticResource T.PageSubtitle}"
                                   Text="Baixe o RealSetup.exe direto da release 'real-v1' do repositório oficial. O arquivo fica na pasta Downloads."
                                   MaxWidth="700" HorizontalAlignment="Left"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.Real}">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar Real" Click="OnDownloadClick" Margin="0,0,12,0" />
                            <Button Style="{StaticResource BtnGhost}" Content="Ver status do Real"
                                    Click="OnStatusClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
