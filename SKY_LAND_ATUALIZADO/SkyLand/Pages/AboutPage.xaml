<UserControl x:Class="SkyLand.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="32,24,32,32">

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SEGURANÇA E PRIVACIDADE" Style="{StaticResource T.CardTitle}" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource T.Body}" Text="• Nenhum pedido de senha, cookie ou token — o aplicativo não solicita credenciais." Margin="0,2,0,10" />
                            <TextBlock Style="{StaticResource T.Body}" Text="• Arquivos baixados são gravados nas mesmas pastas do sistema original e validados (tamanho e, quando disponível, hash SHA-256 publicado na release)." Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource T.Body}" Text="• Nenhum executável baixado roda sem a sua confirmação explícita em diálogo na tela." Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource T.Body}" Text="• Rotinas que removem arquivos (reparo do Madium, substituição de pastas) exibem a lista exata antes de agir." Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource T.Body}" Text="• Atualização do SKY LAND usa apenas os executáveis publicados nas Releases oficiais do repositório, com verificação quando o hash está disponível." Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CRÉDITOS" Style="{StaticResource T.CardTitle}" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,12,0,0"
                                   Text="Joaovictor36484" />
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource T.Body}" Text="Repositório oficial:" Margin="0,0,0,6" />
                            <Button x:Name="BtnGitHubRepo" Style="{StaticResource BtnGhost}"
                                    Content="LINK DO REPOSITÓRIO SKY LAND" Click="OnGitHubClick" />
                        </StackPanel>
                        <TextBlock x:Name="BuildInfo" Style="{StaticResource T.Small}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
