<UserControl x:Class="SkyLand.Pages.PotassiumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ops="clr-namespace:SkyLand"
             xmlns:controls="clr-namespace:SkyLand.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="32,24,32,32">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Image Height="100"
                           Source="pack://application:,,,/Assets/potassium.png"
                           Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="28" ShadowDepth="6"
                                              Direction="-90" Opacity="0.5" />
                        </Image.Effect>
                    </Image>
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Potassium" Style="{StaticResource T.PageTitle}" />
                        <TextBlock Style="{StaticResource T.PageSubtitle}"
                                   Text="Baixe o executor oficial e verifique a dependência WebView2. O download vai direto para a pasta de Downloads configurada."
                                   MaxWidth="700" HorizontalAlignment="Left"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.Potassium}">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Baixar Potassium" Click="OnDownloadClick"
                                    Margin="0,0,12,0" />
                            <Button Style="{StaticResource BtnGhost}" Content="Copiar link"
                                    Click="OnCopyLinkClick" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

                <controls:DownloadCard DataContext="{x:Static ops:OpsStore.WebView2}"
                                       Margin="0,16,0,0">
                    <controls:DownloadCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnGhost}"
                                    Content="Verificar / instalar WebView2"
                                    Click="OnWebView2Click" />
                        </StackPanel>
                    </controls:DownloadCard.Actions>
                </controls:DownloadCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
