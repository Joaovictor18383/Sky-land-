<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: AZUL PROFUNDO (padrão) ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0A0A" Offset="0" />
        <GradientStop Color="#111111" Offset="0.5" />
        <GradientStop Color="#0A0A0A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#050505" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#252525" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#151515" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#444444" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#222222" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#252525" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#444444" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2E3B" Offset="0" />
        <GradientStop Color="#323642" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#AAAAAA" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#666666" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#A78BFA" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#A855F7" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#4C1D95" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#C4B5FD" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
