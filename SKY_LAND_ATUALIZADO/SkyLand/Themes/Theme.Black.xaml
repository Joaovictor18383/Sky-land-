<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================ TEMA: PRETO PURO ================ -->

    <LinearGradientBrush x:Key="Brush.Window.BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#05050C" Offset="0" />
        <GradientStop Color="#040408" Offset="0.45" />
        <GradientStop Color="#000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#04040A" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#0B0B12" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#131320" />
    <SolidColorBrush x:Key="Brush.Surface.Solid2" Color="#0E0E17" />

    <SolidColorBrush x:Key="Brush.Stroke" Color="#1B1B27" />
    <SolidColorBrush x:Key="Brush.Stroke.Hover" Color="#2E2E44" />
    <SolidColorBrush x:Key="Brush.Stroke.Subtle" Color="#151520" />

    <SolidColorBrush x:Key="Brush.Bar" Color="#12121C" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#23232F" />

    <LinearGradientBrush x:Key="Brush.Card.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D0D16" Offset="0" />
        <GradientStop Color="#141420" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ TEXTO ================ -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EEEEF6" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#9B9DBB" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="#63648A" />

    <!-- ================ ACENTOS ================ -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#8B17C0" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="#D8A7FF" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#A64ACF" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#351044" />

    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B17C0" Offset="0" />
        <GradientStop Color="#A64ACF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D8A7FF" Offset="0" />
        <GradientStop Color="#E9D5FF" Offset="1" />
    </LinearGradientBrush>

    <!-- ================ ESTADOS ================ -->

    <SolidColorBrush x:Key="Brush.Success" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F34D399" />
    <SolidColorBrush x:Key="Brush.Success.Text" Color="#A7F3D0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="Brush.Warning.Text" Color="#FDE68A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#F97066" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FF97066" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FDA4A4" />

    <SolidColorBrush x:Key="Brush.Info" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="Brush.Info.Text" Color="#BFDBFE" />

</ResourceDictionary>
