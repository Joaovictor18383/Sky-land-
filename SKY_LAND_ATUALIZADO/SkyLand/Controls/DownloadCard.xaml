<UserControl x:Class="SkyLand.Controls.DownloadCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>

            <!-- Cabeçalho: arte do executor + título + descrição -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Arte incorporada (Potassium / Madium / Real) — em destaque -->
                <Border x:Name="ArtWrap" Width="80" Height="80"
                        VerticalAlignment="Center"
                        MouseEnter="ArtWrap_MouseEnter" MouseLeave="ArtWrap_MouseLeave"
                        Visibility="{Binding ArtUrl, Converter={StaticResource ArtVis}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#8B17C0" BlurRadius="22" ShadowDepth="5"
                                          Direction="-90" Opacity="0.32" />
                    </Border.Effect>
                    <Image Source="{Binding ArtUrl}" Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ArtScale" />
                        </Image.RenderTransform>
                    </Image>
                </Border>

                <!-- Bolha de ícone (operações sem arte própria) -->
                <Grid VerticalAlignment="Center"
                      Visibility="{Binding ArtUrl, Converter={StaticResource ArtInv}}">
                    <Border Style="{StaticResource IconBubble}">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="17"
                                   Foreground="{DynamicResource Brush.Accent.Bright}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Glyph, Converter={StaticResource GlyphVis}}" />
                    </Border>
                    <Border Style="{StaticResource IconBubble}"
                            Visibility="{Binding Letter, Converter={StaticResource LetterVis}}">
                        <TextBlock Text="{Binding Letter}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent.Bright}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource T.CardTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource T.CardSubtitle}" Text="{Binding Description}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Botões da página -->
            <ContentPresenter x:Name="ActionsHost" Margin="0,14,0,0" />

            <!-- Estado ocioso -->
            <TextBlock Style="{StaticResource T.Small}" Text="Pronto."
                       Margin="0,12,0,0"
                       Visibility="{Binding IsIdle, Converter={StaticResource B2V}}" />

            <!-- Painel de execução -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource T.Small}" Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                               Style="{StaticResource T.Small}" />
                </Grid>
                <ProgressBar Style="{StaticResource SlimProgress}"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                             Margin="0,8,0,0" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource T.Small}" Text="{Binding PercentText}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource T.Small}"
                               Text="{Binding SpeedText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Style="{StaticResource T.Small}"
                               Text="{Binding SizeText}" />
                </Grid>
                <Button Style="{StaticResource BtnGhost}" Content="Cancelar"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding CancelVisible, Converter={StaticResource B2V}}"
                        Margin="0,12,0,0" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Resultado -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasResult, Converter={StaticResource B2V}}">
                <Border Style="{DynamicResource BannerResult}">
                    <TextBlock Text="{Binding ResultText}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource BtnGhost}" Content="Abrir pasta"
                            Command="{Binding OpenFolderCommand}"
                            Visibility="{Binding HasTarget, Converter={StaticResource B2V}}" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
