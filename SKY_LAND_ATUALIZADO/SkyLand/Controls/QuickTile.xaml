<UserControl x:Class="SkyLand.Controls.QuickTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Style="{StaticResource CardHover}" Cursor="Hand"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <StackPanel>
            <Grid Height="70">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Arte incorporada do executor (imagem arredondada própria) -->
                <Border Width="60" Height="60"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ArtVis}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#8B17C0" BlurRadius="20" ShadowDepth="5"
                                          Direction="-90" Opacity="0.35" />
                    </Border.Effect>
                    <Image Source="{Binding ImagePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ArtScale" />
                        </Image.RenderTransform>
                    </Image>
                </Border>

                <!-- Glifo -->
                <Border Width="44" Height="44" CornerRadius="14"
                        Background="{DynamicResource Brush.Accent.Soft}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource GlyphVis}}">
                    <TextBlock Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.Accent.Bright}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Letra -->
                <Border Width="44" Height="44" CornerRadius="14"
                        Background="{DynamicResource Brush.Accent.Soft}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Letter, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LetterVis}}">
                    <TextBlock Text="{Binding Letter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.Bright}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="&#xE972;"
                           FontFamily="{StaticResource Font.Icons}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Dim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource T.CardSubtitle}"
                       Margin="0,4,0,0" MaxHeight="32" />
        </StackPanel>
    </Border>
</UserControl>
