<Window x:Class="SkyLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKY LAND"
        Width="1200" Height="760"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        FontFamily="{StaticResource Font.App}">

    <Grid x:Name="RootGrid" Margin="0">
        <Border x:Name="RootBorder"
                CornerRadius="16"
                BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                BorderThickness="1"
                Background="{DynamicResource Brush.Window.BackgroundGradient}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= BARRA LATERAL ================= -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Sidebar.Background}"
                        BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="16,0,0,16"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Grid Margin="20,26,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="14"
                                    Background="{DynamicResource Brush.Accent.Gradient}">
                                <Image Width="38" Height="38" Margin="4"
                                       Source="pack://application:,,,/Assets/emblem.png"
                                       Stretch="Uniform" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SKY LAND" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="CONTROL CENTER"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent.Bright}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Navegação -->
                        <StackPanel Grid.Row="1" Margin="10,2,10,14">
                            <TextBlock Text="MENU PRINCIPAL" Style="{StaticResource T.NavSection}" />
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Início" Tag="&#xE80F;"
                                         IsChecked="True" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavPotassium" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Potassium" Tag="Potassium"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavMadium" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Madium" Tag="Madium"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavReal" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Real" Tag="Real"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavOther" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Outros" Tag="&#xE712;"
                                         Checked="OnNavChecked" />

                            <TextBlock Text="APLICATIVO" Style="{StaticResource T.NavSection}" Margin="18,22,0,8" />

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Configurações" Tag="&#xE713;"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Sobre" Tag="&#xE946;"
                                         Checked="OnNavChecked" />
                        </StackPanel>

                        <!-- Rodapé -->
                        <Border Grid.Row="2" Margin="16,6,16,18" Padding="12,11"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9"
                                        Background="{DynamicResource Brush.Accent.Gradient}">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}"
                                               Foreground="White"
                                               FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SKY LAND para Windows" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock x:Name="VersionFooter" Text="Versão  ·  x64" Style="{StaticResource T.Small}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= CONTEÚDO ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Barra de título -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                                <TextBlock Text="SKY LAND" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Dim}" />
                                <TextBlock Text="/" Margin="9,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.Text.Dim}" />
                                <TextBlock x:Name="CrumbText" Text="Início"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                            <StackPanel x:Name="WindowButtons" Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                <Button x:Name="BtnMin" Style="{StaticResource WinBtn}"
                                        Content="&#xE921;" Click="BtnMin_Click" ToolTip="Minimizar" />
                                <Button x:Name="BtnMax" Style="{StaticResource WinBtn}"
                                        Content="&#xE922;" Click="BtnMax_Click" ToolTip="Maximizar" />
                                <Button x:Name="BtnClose" Style="{StaticResource WinBtnClose}"
                                        Content="&#xE8BB;" Click="BtnClose_Click" ToolTip="Fechar" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Páginas -->
                    <ContentControl Grid.Row="1" x:Name="PageHost" Focusable="False" />
                </Grid>

                <!-- ================= TOASTS ================= -->
                <StackPanel x:Name="ToastHost"
                            Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,18,18" />

                <!-- ================= DIÁLOGOS ================= -->
                <Grid x:Name="DialogOverlay" Grid.Column="0" Grid.ColumnSpan="2"
                      Visibility="Collapsed" Background="#9905050A">
                    <Border x:Name="DialogCard" Width="520" MaxWidth="580"
                            CornerRadius="16"
                            Background="{DynamicResource Brush.Surface.Solid2}"
                            BorderBrush="{DynamicResource Brush.Stroke}"
                            BorderThickness="1"
                            Padding="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl x:Name="DialogContent" Focusable="False" />
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
