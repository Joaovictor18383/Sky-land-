<Window x:Class="SkyLand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKY LAND"
        Width="1200" Height="760"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        FontFamily="{StaticResource Font.App}">

    <Grid x:Name="RootGrid" Margin="0">
        <Border x:Name="RootBorder"
                CornerRadius="16"
                BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                BorderThickness="1"
                Background="{DynamicResource Brush.Window.BackgroundGradient}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= BARRA LATERAL ================= -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Sidebar.Background}"
                        BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="16,0,0,16"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Grid Margin="22,30,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="13"
                                    Background="{DynamicResource Brush.Metallic}">
                                <Image Width="36" Height="36" Margin="4"
                                       Source="pack://application:,,,/Assets/emblem.png"
                                       Stretch="Uniform" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SKY LAND" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                            </StackPanel>
                        </Grid>

                        <!-- Navegação -->
                        <StackPanel Grid.Row="1" Margin="12,0,12,16">
                            <TextBlock Text="MENU PRINCIPAL" Style="{StaticResource T.NavSection}" />
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Início" Tag="&#xE80F;"
                                         IsChecked="True" Checked="OnNavChecked" />
                            <RadioButton x:Name="NavPotassium" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Potassium" Tag="Potassium"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavMadium" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Madium" Tag="Madium"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavReal" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Real" Tag="Real"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavOther" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Outros" Tag="&#xE712;"
                                         Checked="OnNavChecked" />

                            <TextBlock Text="APLICATIVO" Style="{StaticResource T.NavSection}" Margin="18,22,0,8" />

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Configurações" Tag="&#xE713;"
                                         Checked="OnNavChecked" />
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Content="Sobre" Tag="&#xE946;"
                                         Checked="OnNavChecked" />
                        </StackPanel>

                        <!-- Rodapé -->
                        <Border Grid.Row="2" Margin="16,4,16,16" Padding="12,10"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9"
                                        Background="{DynamicResource Brush.Metallic}">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}"
                                               Foreground="White"
                                               FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SKY LAND para Windows" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <TextBlock x:Name="VersionFooter" Text="Versão  ·  x64" Style="{StaticResource T.Small}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= CONTEÚDO ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra de título -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Brush.Stroke.Subtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                                <TextBlock Text="SKY LAND" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Dim}" />
                                <TextBlock Text="/" Margin="9,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.Text.Dim}" />
                                <TextBlock x:Name="CrumbText" Text="Início"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                            <StackPanel x:Name="WindowButtons" Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                <Button x:Name="BtnMin" Style="{StaticResource WinBtn}"
                                        Content="&#xE921;" Click="BtnMin_Click" ToolTip="Minimizar" />
                                <Button x:Name="BtnMax" Style="{StaticResource WinBtn}"
                                        Content="&#xE922;" Click="BtnMax_Click" ToolTip="Maximizar" />
                                <Button x:Name="BtnClose" Style="{StaticResource WinBtnClose}"
                                        Content="&#xE8BB;" Click="BtnClose_Click" ToolTip="Fechar" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Páginas -->
                    <ContentControl Grid.Row="1" x:Name="PageHost" Focusable="False" />

                    <!-- ================= PAINEL DE OPERAÇÕES ================= -->
                    <Border x:Name="OpsPanel" Grid.Row="2"
                            Margin="26,0,26,14" Padding="16,13"
                            CornerRadius="14"
                            Background="{DynamicResource Brush.Surface.Solid2}"
                            BorderBrush="{DynamicResource Brush.Stroke}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6"
                                              Direction="270" Opacity="0.35" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho: ícone + textos + porcentagem -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="OpsIcon" Width="36" Height="36" CornerRadius="10"
                                        Background="{DynamicResource Brush.Accent.Soft}"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="OpsIconGlyph" Text="&#xE896;"
                                               FontFamily="{StaticResource Font.Icons}"
                                               FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent.Bright}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Text" Value="&#xEA39;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HeadlineText}" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PercentText}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="10" Style="{StaticResource T.Small}"
                                               HorizontalAlignment="Right" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Barra de progresso real -->
                            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}"
                                         Height="6" Margin="0,11,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate}" />

                            <!-- Rodapé: detalhe + ações -->
                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Text.Dim}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Cancelar" Command="{Binding CancelCommand}"
                                            Padding="14,5" FontSize="11"
                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowCancel}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Abrir pasta" Command="{Binding OpenFolderCommand}"
                                            Padding="14,5" FontSize="11"
                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTarget}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource WinBtn}" Content="&#xE711;"
                                            Command="{Binding DismissCommand}" Width="30" Height="26"
                                            VerticalAlignment="Center" Opacity="0.75" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= TOASTS ================= -->
                <StackPanel x:Name="ToastHost"
                            Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,62,18,0" />

                <!-- ================= DIÁLOGOS ================= -->
                <Grid x:Name="DialogOverlay" Grid.Column="0" Grid.ColumnSpan="2"
                      Visibility="Collapsed" Background="#9905050A">
                    <Border x:Name="DialogCard" Width="520" MaxWidth="580"
                            CornerRadius="16"
                            Background="{DynamicResource Brush.Surface.Solid2}"
                            BorderBrush="{DynamicResource Brush.Stroke}"
                            BorderThickness="1"
                            Padding="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl x:Name="DialogContent" Focusable="False" />
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
